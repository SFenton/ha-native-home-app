  "logicLibrary": [
   {
    "id": "count-or-all",
    "name": "Count or All",
    "kind": "operand",
    "params": [
     {
      "name": "count",
      "kind": "operand",
      "label": "Count",
      "sample": {
       "type": "literal",
       "value": 3
      }
     },
     {
      "name": "word",
      "kind": "text",
      "label": "Word",
      "sample": "On"
     },
     {
      "name": "whenNone",
      "kind": "text",
      "label": "When None",
      "sample": "All Closed"
     }
    ],
    "body": {
     "type": "choose",
     "cases": [
      {
       "when": {
        "type": "compare",
        "op": "above",
        "left": {
         "type": "hole",
         "name": "count"
        },
        "right": {
         "type": "literal",
         "value": 0
        }
       },
       "then": {
        "type": "format",
        "pattern": "{a} {b}",
        "args": {
         "a": {
          "type": "hole",
          "name": "count"
         },
         "b": {
          "type": "literal",
          "value": {
           "type": "hole",
           "name": "word"
          }
         }
        }
       }
      }
     ],
     "otherwise": {
      "type": "literal",
      "value": {
       "type": "hole",
       "name": "whenNone"
      }
     }
    }
   },
   {
    "id": "yours-or-theirs",
    "name": "Yours or Theirs",
    "kind": "operand",
    "params": [
     {
      "name": "person",
      "kind": "text",
      "label": "Person",
      "sample": "person.demo_sam",
      "display": "person"
     },
     {
      "name": "name",
      "kind": "text",
      "label": "Name",
      "sample": "Sam"
     },
     {
      "name": "thing",
      "kind": "text",
      "label": "Thing",
      "sample": "Chores"
     }
    ],
    "body": {
     "type": "choose",
     "cases": [
      {
       "when": {
        "type": "compare",
        "op": "eq",
        "left": {
         "type": "viewer",
         "field": "personEntityId"
        },
        "right": {
         "type": "literal",
         "value": {
          "type": "hole",
          "name": "person"
         }
        }
       },
       "then": {
        "type": "format",
        "pattern": "Your {a}",
        "args": {
         "a": {
          "type": "literal",
          "value": {
           "type": "hole",
           "name": "thing"
          }
